// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  deposits  Deposit[]
  notes     Note[]
  reactions Reaction[]
  comments  Comment[]
  memories  Memory[]
  memoryComments MemoryComment[]
  totpSecrets TotpSecret[]
  contacts  Contact[]
  commentReactions CommentReaction[]
  memoryCommentReactions MemoryCommentReaction[]
}

model Deposit {
  id        Int      @id @default(autoincrement())
  amount    Float
  month     String
  year      String
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id        Int      @id @default(autoincrement())
  pin       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        Int        @id @default(autoincrement())
  content   String
  emoji     String?
  userId    Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  comments  Comment[]
}

model Reaction {
  id        Int      @id @default(autoincrement())
  type      String   // like, love, haha, wow, sad, angry
  noteId    Int
  userId    Int
  createdAt DateTime @default(now())

  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  noteId    Int
  userId    Int
  createdAt DateTime @default(now())

  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions CommentReaction[]
}

model CommentReaction {
  id        Int      @id @default(autoincrement())
  type      String   // like, love, etc
  commentId Int
  userId    Int
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Memory {
  id          Int      @id @default(autoincrement())
  imageUrl    String?  @db.Text // Deprecated: Kept for backward compatibility
  description String
  date        DateTime
  userId      Int
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  images      MemoryImage[]
  comments    MemoryComment[]
}

model MemoryImage {
  id        Int      @id @default(autoincrement())
  url       String   @db.Text
  memoryId  Int

  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
}

model MemoryComment {
  id        Int      @id @default(autoincrement())
  content   String
  memoryId  Int
  userId    Int
  createdAt DateTime @default(now())

  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions MemoryCommentReaction[]
}

model MemoryCommentReaction {
  id              Int           @id @default(autoincrement())
  type            String
  memoryCommentId Int
  userId          Int
  createdAt       DateTime      @default(now())

  memoryComment   MemoryComment @relation(fields: [memoryCommentId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memoryCommentId, userId])
}

model TotpSecret {
  id        Int      @id @default(autoincrement())
  label     String
  secret    String
  issuer    String?
  userId    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  number    String
  isActive  Boolean  @default(true)
  userId    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
